{
  "name": "lumi-lens-design-check",
  "version": "0.1.0",
  "private": true,
  "description": "LUMI Lens — Design Check Figma plugin",
  "type": "module",
  "scripts": {
    "build": "npm run build:ui && npm run build:code",
    "build:ui": "./node_modules/.bin/vite build && node scripts/normalize-ui.mjs",
    "build:code": "node scripts/build-code.mjs",
    "dev": "./node_modules/.bin/vite build --watch",
    "typecheck": "./node_modules/.bin/tsc --noEmit",
    "lint": "./node_modules/.bin/eslint .",
    "test": "node --import tsx/esm --test tests/audits.test.ts",
    "test:watch": "node --import tsx/esm --test --watch tests/audits.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@figma/plugin-typings": "^1.120.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "tsx": "^4.19.2",
    "vite": "^6.1.0"
  }
}
